# Copy to `.env` and the test suite picks it up on its own.
#
# These values match `docker/compose.yml`, so after `make db-up` the whole
# suite runs against local containers with no further setup. Ports are
# deliberately non-default so a database you already run locally does not
# collide with them.
#
# `.env` is git-ignored. Never put a production credential in it: the tests
# create and drop schemas, and a scratch prefix is the only thing standing
# between them and whatever else lives in that database.

# --- target (PostgreSQL) -----------------------------------------------------
#
# Two names on purpose, each with a different job:
#   DBX_GOLDEN_TEST_DSN is the **switch** for the database tests. Without it
#     they skip rather than fail, which is right locally and wrong in CI.
#   DBX_GOLDEN_DSN is the comparison tool's own **database access**.
DBX_GOLDEN_TEST_DSN=host=127.0.0.1 port=55432 dbname=dbx user=dbx password=dbx
DBX_GOLDEN_DSN=host=127.0.0.1 port=55432 dbname=dbx user=dbx password=dbx

# --- sources -----------------------------------------------------------------
#
# Each source has its own switch, and its tests skip without it. Uncomment only
# what you have running: `make db-up` starts all four, but there is no need to
# run MSSQL just to work on the MySQL dialect.

DBX_TEST_MYSQL_DSN=host=127.0.0.1 port=53306 database=dbx_src user=dbx password=dbx

DBX_TEST_MSSQL_DSN=host=127.0.0.1 port=51433 database=dbx_src user=sa password=dbxDBX123!

# Firebird takes a server-side path, not a path on your machine.
DBX_TEST_FIREBIRD_DSN=host=127.0.0.1 port=53050 database=/firebird/data/dbx_src.fdb user=SYSDBA password=masterkey charset=WIN1250

# --- optional ----------------------------------------------------------------

# Overrides where the package writes, ignoring io_config.yaml entirely.
# DBX_TARGET_DSN=

# Forces the characterisation oracle into a mode instead of detecting it.
# DBX_ORACLE_MODE=replay
